DJANGO_SECRET_KEY=replace-with-at-least-32-random-characters
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://app.example.com
CSRF_TRUSTED_ORIGINS=https://api.example.com
# 운영 DB: postgresql://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=
# AWS RDS에서는 URL 대신 아래 개별 값을 사용하는 편이 안전합니다.
DB_HOST=
DB_PORT=5432
DB_NAME=aura
DB_USER=aura_app
DB_PASSWORD=
DB_CONN_MAX_AGE=600
# 운영 업로드 파일 저장소. 비워 두면 로컬 media/를 사용합니다.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-northeast-2
AWS_QUERYSTRING_AUTH=true
# HTTPS 연결이 확인된 뒤 운영 환경에서 true로 설정합니다.
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_HSTS_SECONDS=0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MAX_OUTPUT_TOKENS=500
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_VISION_MAX_OUTPUT_TOKENS=700
OPENAI_TIMEOUT_SECONDS=30
FRONTEND_DIAGNOSIS_PATH_TEMPLATE=/care/diagnoses/{id}
FRONTEND_VISIT_PATH_TEMPLATE=/my/visit-reservations/{id}
FRONTEND_MEMBERSHIP_PATH=/my/membership
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
# Kakao Developers에서 발급받은 REST API 키
# CSV 주소를 위도·경도로 변환할 때만 필요합니다.
KAKAO_REST_API_KEY=
